// $escaper is given to templates only on newer Magento versions; the block has the same escape methods
$escaper = isset($escaper) ? $escaper : $block;
$label = $block->getConnectionLabel();
?>
<div class="control-value">
    <strong><?= $escaper->escapeHtml($block->isConnected() ? __('Connected') : __('Not connected')) ?></strong>
    <?php if ($block->isConnected() && $label !== ''): ?>
        &middot; <?= $escaper->escapeHtml($label) ?>
    <?php endif; ?>
</div>
<p class="note">
    <span>
        <?= $escaper->escapeHtml(__(
            'The connection, the chat widget, the product feed and the order tracking are set on the module page.'
        )) ?>
    </span>
</p>
<a class="action-default" href="<?= $escaper->escapeUrl($block->getModuleUrl()) ?>">
    <?= $escaper->escapeHtml(__('Open Ovebot AI')) ?>
</a>
