<!-- The purchase event, used by the order success pages (checkout_onepage_success, multishipping_checkout_success) -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Before the widget, so the purchases are in the page when widget.js runs. cacheable="false": the
             purchases belong to one visitor (the success pages are not cached anyway) -->
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="ovebot.chat.purchase"
                   template="Ovebot_Chat::purchase.phtml" before="ovebot.chat.widget" cacheable="false">
                <arguments>
                    <argument name="purchase" xsi:type="object">Ovebot\Chat\ViewModel\Purchase</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
